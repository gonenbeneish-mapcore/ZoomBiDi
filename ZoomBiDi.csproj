<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RollForward>Major</RollForward>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Needed for System.Windows.Automation (UI Automation client) -->
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>ZoomBiDi</AssemblyName>
    <RootNamespace>ZoomBiDi</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>1.0.0</Version>
    <Product>ZoomBiDi</Product>
    <AssemblyTitle>ZoomBiDi – Hebrew/English direction fix for Zoom chat</AssemblyTitle>
    <!-- Icons are generated by tools\MakeIcon.ps1 -->
    <ApplicationIcon>assets\ZoomBiDi.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="assets\ZoomBiDi.ico" LogicalName="ZoomBiDi.ico" />
    <EmbeddedResource Include="assets\ZoomBiDi-paused.ico" LogicalName="ZoomBiDi-paused.ico" />
  </ItemGroup>

</Project>
